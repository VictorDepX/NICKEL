# Copie para .env e preencha. `nickel keys` gera OAUTH_TOKEN_KEY e BRIDGE_TOKEN.

# --- Geral
NICKEL_HOST=127.0.0.1
NICKEL_PORT=8000
NICKEL_DATA_DIR=./data
NICKEL_TIMEZONE=America/Sao_Paulo

# --- Modelo
# ollama: GPU local. llamacpp: llama-server local (veja docs/deploy/local-windows-llamacpp.md).
# openai: RunPod Serverless (vLLM) ou outro provedor compatível.
LLM_PROVIDER=ollama
# Ollama: http://127.0.0.1:11434   llama-server: http://127.0.0.1:8080/v1
# RunPod: https://api.runpod.ai/v2/<ENDPOINT_ID>/openai/v1
LLM_BASE_URL=http://127.0.0.1:11434
# Só para provider openai (chave da API do RunPod)
LLM_API_KEY=
# Ollama: qwen3.6:27b   RunPod: o valor de OPENAI_SERVED_MODEL_NAME_OVERRIDE do endpoint
LLM_MODEL=qwen3.6:27b
LLM_NUM_CTX=16384
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.3
LLM_THINK=false
# Streaming de tokens (raciocínio ao vivo na auditoria)
LLM_STREAM=true
# RunPod: 300 (a partida a frio pode levar minutos)
LLM_TIMEOUT_SECONDS=180
LLM_RETRIES=2
LLM_KEEP_ALIVE=30m

# --- Workspaces (perfis de trabalho sobre o mesmo modelo; veja workspaces/README.md)
# Pasta com os arquivos .md. Pode ficar dentro do vault para editar pelo Obsidian.
WORKSPACES_DIR=./workspaces
WORKSPACE_DEFAULT=geral
# Troca de workspace por palavras-chave do frontmatter (menos preciso que o comando /nome)
WORKSPACE_AUTO_ROUTE=false
WORKSPACE_AUTO_THRESHOLD=2

# --- Backend cloud opcional (workspaces com `backend: cloud`). Sem isso, usam o modelo local.
LLM_CLOUD_BASE_URL=
LLM_CLOUD_API_KEY=
LLM_CLOUD_MODEL=
LLM_CLOUD_TIMEOUT_SECONDS=300

# --- Segredos
OAUTH_TOKEN_KEY=
BRIDGE_TOKEN=

# --- Google (Gmail + Agenda). Crie um "OAuth client ID" do tipo Web no Google Cloud Console
# e cadastre o redirect abaixo.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_CALENDAR_ID=primary

# --- Spotify (Development Mode exige Premium). Cadastre o redirect exatamente assim (127.0.0.1, não localhost).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/auth/spotify/callback
# Nome do dispositivo preferido (opcional), como aparece no Spotify Connect
SPOTIFY_DEVICE_NAME=
SPOTIFY_MARKET=BR

# --- WhatsApp (bridge em whatsapp-bridge/)
WA_BRIDGE_URL=http://127.0.0.1:8002
# Responder também com nota de voz quando você mandar áudio
WA_VOICE_REPLIES=false
# Avisa "o modelo pode estar iniciando" se a resposta demorar mais que isso (0 desliga)
WA_SLOW_NOTICE_SECONDS=8
# Chromium usado pela bridge (o install-server.sh preenche; vazio = baixa automaticamente)
CHROME_PATH=

# --- Obsidian: caminho do vault "Editora" sincronizado pelo Syncthing
OBSIDIAN_VAULT_PATH=~/Sync/Editora
OBSIDIAN_NOTES_DIR=06 Pensamentos

# --- Voz
VOICE_ENABLED=true
STT_MODEL=large-v3-turbo
STT_DEVICE=cuda
STT_COMPUTE_TYPE=int8_float16
STT_LANGUAGE=pt
TTS_VOICE_PATH=./models/piper/pt_BR-faber-medium.onnx
# Voz de saída: auto (VoiceStudio se VOICESTUDIO_URL existir, senão Piper) | voicestudio | piper | none
TTS_PROVIDER=auto
# VoiceStudio: abra o app e copie a URL e a chave da API dele
VOICESTUDIO_URL=http://127.0.0.1:3900
VOICESTUDIO_API_KEY=
# Motor de voz (ex.: omnivoice, voxcpm2, kittentts)
VOICESTUDIO_MODEL=omnivoice
# Nome de um perfil de voz do VoiceStudio
VOICESTUDIO_VOICE=default
VOICE_MAX_SECONDS=30
VOICE_SILENCE_SECONDS=1.5
VOICE_NOTIFY=true
VOICE_OPEN_LINKS=true

# --- Música
MUSIC_AUTO_DETECT=true
MUSIC_RECORD_SECONDS=10

# --- Lembretes
REMINDERS_USE_CALENDAR=true
REMINDER_LATE_GRACE_HOURS=12
