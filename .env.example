# Copie para .env e preencha. `nickel keys` gera OAUTH_TOKEN_KEY e BRIDGE_TOKEN.

# --- Geral
NICKEL_HOST=127.0.0.1
NICKEL_PORT=8000
NICKEL_DATA_DIR=./data
NICKEL_TIMEZONE=America/Sao_Paulo

# --- Modelo (Ollama)
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3.6:27b
LLM_NUM_CTX=16384
LLM_TEMPERATURE=0.3
LLM_THINK=false
LLM_KEEP_ALIVE=30m

# --- Segredos
OAUTH_TOKEN_KEY=
BRIDGE_TOKEN=

# --- Google (Gmail + Agenda). Crie um "OAuth client ID" do tipo Web no Google Cloud Console
# e cadastre o redirect abaixo.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_CALENDAR_ID=primary

# --- Spotify (Development Mode exige Premium). Cadastre o redirect exatamente assim (127.0.0.1, não localhost).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/auth/spotify/callback
# Nome do dispositivo preferido (opcional), como aparece no Spotify Connect
SPOTIFY_DEVICE_NAME=
SPOTIFY_MARKET=BR

# --- WhatsApp (bridge em whatsapp-bridge/)
WA_BRIDGE_URL=http://127.0.0.1:8002
# Responder também com nota de voz quando você mandar áudio
WA_VOICE_REPLIES=false

# --- Obsidian: caminho do vault "Editora" sincronizado pelo Syncthing
OBSIDIAN_VAULT_PATH=~/Sync/Editora
OBSIDIAN_NOTES_DIR=06 Pensamentos

# --- Voz
VOICE_ENABLED=true
STT_MODEL=large-v3-turbo
STT_DEVICE=cuda
STT_COMPUTE_TYPE=int8_float16
STT_LANGUAGE=pt
TTS_VOICE_PATH=./models/piper/pt_BR-faber-medium.onnx
VOICE_MAX_SECONDS=30
VOICE_SILENCE_SECONDS=1.5
VOICE_NOTIFY=true
VOICE_OPEN_LINKS=true

# --- Música
MUSIC_AUTO_DETECT=true
MUSIC_RECORD_SECONDS=10

# --- Lembretes
REMINDERS_USE_CALENDAR=true
REMINDER_LATE_GRACE_HOURS=12
